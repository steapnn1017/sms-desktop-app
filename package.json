{
  "name": "sms-desktop-app",
  "version": "1.0.0",
  "description": "Firemní SMS manager pro odesílání zpráv zákazníkům přes Android SMS Gateway",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev -p 3000",
    "electron:dev": "wait-on tcp:3000 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "next:build": "next build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build": "npm run next:build && npm run electron:build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "better-sqlite3": "^9.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "lucide-react": "^0.344.0",
    "next": "14.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "ts-node": "^10.9.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.company.sms-desktop-app",
    "productName": "SMS Manager",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@types/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/ts-node/**/*",
      "!node_modules/autoprefixer/**/*",
      "!node_modules/postcss/**/*",
      "!node_modules/tailwindcss/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/wait-on/**/*",
      "!node_modules/next/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "author": {
    "name": "Company",
    "email": "info@company.cz"
  },
  "license": "UNLICENSED",
  "private": true
}