{
  "name": "sms-desktop-app",
  "version": "1.0.0",
  "description": "Firemní SMS manager pro odesílání zpráv zákazníkům přes Android SMS Gateway",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev -p 3000",
    "electron:dev": "wait-on tcp:3000 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "next:build": "next build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build": "npm run next:build && npm run electron:build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "prisma generate && electron-builder install-app-deps",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project tsconfig.electron.json prisma/seed.ts",
    "prisma:push": "prisma db push"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.electron.json prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "lucide-react": "^0.344.0",
    "next": "14.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "ts-node": "^10.9.2",
    "wait-on": "^7.2.0"
  },
  "author": {
    "name": "Company",
    "email": "info@company.cz"
  },
  "license": "UNLICENSED",
  "private": true
}